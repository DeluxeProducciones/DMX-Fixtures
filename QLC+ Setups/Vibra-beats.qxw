            </Appearance>
          </Label>
        </Frame>
        <Label Caption="Arriba: en qué estado está la sala. Solo puede haber UNO — pulsar otro cambia el estado, no se suman. AUTO es el normal: colores, humo y la noche subiendo y bajando sola." ID="20">
          <WindowState Visible="True" X="8" Y="700" Width="1416" Height="24"/>
          <Appearance>
            <FrameStyle>None</FrameStyle>
            <ForegroundColor>Default</ForegroundColor>
            <BackgroundColor>Default</BackgroundColor>
            <BackgroundImage>None</BackgroundImage>
            <Font>Sans Serif,11,-1,5,50,0,0,0,0,0</Font>
          </Appearance>
        </Label>
        <Label Caption="Los MOMENTOS son para cuando pasa algo: alguien sube a hablar (CHARLA), la sala baja (TRANQUILO), va bien (FIESTA), el último tema (LOCURA). Cuando pase el momento, vuelve a pulsar AUTO." ID="21">
          <WindowState Visible="True" X="8" Y="726" Width="1416" Height="24"/>
          <Appearance>
            <FrameStyle>None</FrameStyle>
            <ForegroundColor>Default</ForegroundColor>
            <BackgroundColor>Default</BackgroundColor>
            <BackgroundImage>None</BackgroundImage>
            <Font>Sans Serif,11,-1,5,50,0,0,0,0,0</Font>
          </Appearance>
        </Label>
        <Label Caption="Abajo: los GOLPES. Esos SÍ se suman a lo que esté sonando. FLASH y HUMO YA funcionan mientras los mantienes pulsados y se apagan al soltar." ID="22">
