  <Author>Cristian Deluxe</Author>
 </Creator>
 <Manufacturer>M-VAVE</Manufacturer>
 <Model>SMC-PAD</Model>
 <Type>MIDI</Type>
 <!--
   Captured 2026-08-29 from the real device over USB (port "SINCO SMC-PAD-Master").
   The device splits its controls across two MIDI channels, so the QLC+ MIDI input
   must be set to MIDI channel "1-16" (omni). In omni mode QLC+ ORs the 0-based
   MIDI channel into bits 12+ of the input channel number:
     pads    ch10 (0-based 9)  -> 36864 + 128 + note   (notes 4-19, shift 52-67)
     knobs   ch1  (0-based 0)  ->     0 +   0 + cc     (CC 30-37, absolute 0-127)
     buttons ch1  (0-based 0)  ->     0 +   0 + cc     (CC 25-29, 127 press / 0 release)
   Pads are numbered 1-16 reading order, top-left to bottom-right.
 -->
 <Channel Number="36996">
  <Name>Pad 1</Name>
  <Type>Button</Type>
 </Channel>
